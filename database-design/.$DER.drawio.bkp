        <mxCell id="iiRl8w4fCP4vkBYx9b8L-46" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div&gt;UNIVERSO DEL DISCURSO&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Crear BD aplicación organizador de lectura tipo goodreads sin red social en la nube.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Debemos guardar los datos del usuario, nombre de usuario, email, contraseña.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Libro, debemos registrar titulo, escritor, descripción, fecha de publicación, cover, isbn, páginas.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Debemos poner el status del libro, quiero leer, leyendo, leído. Rating. Género.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Organizar la lectura, fecha de inicio, fin, progreso de páginas.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Escritor, debemos registrar nombre.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Shelves, que se puedan crear estanterías.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Notas, que se pueda escribir notas de los libros.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="80" y="40" as="geometry" />
        </mxCell>
